{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-phase6/types/**/*.ts",
    ".next-phase6/dev/types/**/*.ts",
    ".next-phase7/types/**/*.ts",
    ".next-phase7/dev/types/**/*.ts",
    ".next-phase8/types/**/*.ts",
    ".next-phase8/dev/types/**/*.ts",
    ".next-phase9b/types/**/*.ts",
    ".next-phase9b/dev/types/**/*.ts",
    ".next-phase10/types/**/*.ts",
    ".next-phase10/dev/types/**/*.ts",
    ".next-phase11/types/**/*.ts",
    ".next-phase11/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
